# Enterprise Agent OS — Environment Variables
# Copy to .env and fill in values

# App
AOS_DEBUG=true
AOS_ENVIRONMENT=development
AOS_LOG_LEVEL=INFO

# Database
AOS_DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_os

# Redis
AOS_REDIS_URL=redis://localhost:6379/0

# Auth
AOS_JWT_SECRET=CHANGE-ME-IN-PRODUCTION
AOS_JWT_EXPIRE_MINUTES=60

# LLM
AOS_OPENAI_API_KEY=sk-...
AOS_OPENAI_MODEL_ROUTER=gpt-4o-mini
AOS_OPENAI_MODEL_MAIN=gpt-4o

# Qdrant
AOS_QDRANT_URL=http://localhost:6333

# Token Budget
AOS_TOKEN_BUDGET_PER_TURN=50000
AOS_TOKEN_BUDGET_PER_DAY=1000000

# Observability
AOS_SENTRY_DSN=
